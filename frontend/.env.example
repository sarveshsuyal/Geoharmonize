# GeoHarmonize Frontend Environment Variables
# Copy to .env for local development.

# Production: Set this in the Vercel Dashboard -> Settings -> Environment Variables
# Point this to your deployed Django backend API URL (including the /api suffix).
VITE_API_BASE_URL=https://geoharmonize-backend-8b1m.onrender.com/api

# Optional: MapTiler API Key (if switching from default free Esri/OSM basemaps)
# VITE_MAPTILER_API_KEY=
