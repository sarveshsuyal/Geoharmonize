
# ==========================================
# GEOHARMONIZE - BACKEND ENVIRONMENT
# ==========================================

# Django configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database configuration
# Leave DATABASE_URL empty for local Docker-based database settings.
# On Render, configure DATABASE_URL in the Render dashboard.
DATABASE_URL=
DB_SSL_REQUIRE=False

POSTGRES_DB=geoharmonize
POSTGRES_USER=geoharmonize
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend and CORS configuration
FRONTEND_URL=http://localhost:5173

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEXES=

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Geospatial configuration
PROJECT_TARGET_CRS=EPSG:32644

# Upload configuration
MAX_UPLOAD_SIZE_MB=200

# Production server configuration
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120

# Logging
DJANGO_LOG_LEVEL=DEBUG

# Optional Administrator Bootstrap (opt-in on initial setup)
BOOTSTRAP_ADMIN=False
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
