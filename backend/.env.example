# ==============================================================================
# GeoHarmonize Backend Environment Configuration (.env.example)
# Copy to .env for local usage. NEVER commit your actual .env file or real secrets.
# ==============================================================================

# --- Security & Core ---
# Generate a secure key in production (e.g., using: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
# In production set DJANGO_DEBUG=False. Set to True only during local development.
DJANGO_DEBUG=False
# Comma-separated list of hostnames/IPs this backend service will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-backend-domain.com

# --- Database (PostgreSQL + PostGIS mandatory) ---
POSTGRES_DB=geoharmonize
POSTGRES_USER=geoharmonize
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS & CSRF (Frontend Integration) ---
# Comma-separated allowed origins. In production, add your Vercel frontend URL:
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-geoharmonize-frontend.vercel.app
# Automatically allow Vercel preview deployment URLs (*.vercel.app)
CORS_ALLOW_VERCEL_PREVIEWS=True
# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=https://your-geoharmonize-frontend.vercel.app,https://your-backend-domain.com

# --- Geospatial & Business Configuration ---
PROJECT_TARGET_CRS=EPSG:32644
MAX_UPLOAD_SIZE_MB=200

# --- Optional Local OS Overrides (Only if running outside Docker on macOS/Linux) ---
# GDAL_LIBRARY_PATH=/usr/lib/libgdal.so
# GEOS_LIBRARY_PATH=/usr/lib/libgeos_c.so
