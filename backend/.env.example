# ==============================================================================
# GeoHarmonize Backend Environment Configuration (.env.example)
# ==============================================================================

# --- Security & Core ---
# Generate a secure key in production (e.g., using: python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
# In production set DJANGO_DEBUG=False. Set to True only during local development.
DJANGO_DEBUG=False
# Comma-separated list of hostnames/IPs this backend service will serve (*.onrender.com is auto-detected).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# --- Database Options ---
# Option A (Cloud / Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Option B (Local Docker Compose):
POSTGRES_DB=geoharmonize
POSTGRES_USER=geoharmonize
POSTGRES_PASSWORD=geoharmonize
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Set to True if database connection requires SSL (default: auto-detected, True for remote cloud databases)
DB_SSL_REQUIRE=False

# --- CORS & CSRF (Frontend Integration) ---
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app,https://your-frontend.onrender.com
CORS_ALLOW_VERCEL_PREVIEWS=True
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app,https://your-backend.onrender.com

# --- Geospatial & Business Configuration ---
PROJECT_TARGET_CRS=EPSG:32644
MAX_UPLOAD_SIZE_MB=200
