# ==========================================
# GEOHARMONIZE - BACKEND ENVIRONMENT
# ==========================================

# Django configuration
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com,geoharmonize-backend-8b1m.onrender.com,localhost,127.0.0.1,backend

# Database configuration
# On Render, DATABASE_URL is automatically provided by the PostgreSQL database.
DATABASE_URL=
DB_SSL_REQUIRE=True

POSTGRES_DB=geoharmonize
POSTGRES_USER=geoharmonize
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend and CORS configuration
FRONTEND_URL=https://geoharmonize-xi.vercel.app

CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://geoharmonize-xi.vercel.app
CORS_ALLOWED_ORIGIN_REGEXES=

CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://geoharmonize-xi.vercel.app,https://geoharmonize-backend-8b1m.onrender.com

# Geospatial configuration
PROJECT_TARGET_CRS=EPSG:32644

# Upload configuration
MAX_UPLOAD_SIZE_MB=200

# Production server configuration
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=120

# Logging
DJANGO_LOG_LEVEL=INFO

# Optional Administrator Bootstrap (opt-in on initial setup)
BOOTSTRAP_ADMIN=False
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
